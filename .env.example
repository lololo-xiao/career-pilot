# Never commit real credentials. Copy this file to .env for local runs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREERPILOT_AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_DATABASE_PATH=.data/careerpilot.db

# Provider runtime. Browser users supply their own API key or authorize Codex.
OPENAI_MODEL=gpt-5.6-sol
CODEX_BINARY=codex
CODEX_LOGIN_TIMEOUT_SECONDS=900
# Hermes calls the hidden career bridge only over this loopback API root.
CAREERPILOT_INTERNAL_API_URL=http://127.0.0.1:8000

FRONTEND_ORIGINS=http://localhost:3000
# Advanced private iOS access only. The CLI sets these when --allow-remote is used;
# never enable them on an unprotected public server.
CAREERPILOT_ALLOW_PRIVATE_MOBILE_DISCOVERY=false
# Used as a frontend Docker build argument. Set this to the public API URL in deploys.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional Langfuse Cloud (EU) observability. Tracing remains off until both keys exist.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=local
